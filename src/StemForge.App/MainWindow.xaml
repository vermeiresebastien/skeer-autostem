<Window x:Class="StemForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skeer autoSTEM"
        Height="880" Width="1280" MinHeight="700" MinWidth="1040"
        WindowStartupLocation="Manual"
        Background="{StaticResource IvoryBrush}"
        Foreground="{StaticResource CharcoalBrush}"
        Icon="pack://application:,,,/Brand/skeer-mark.png"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        TextOptions.TextFormattingMode="Ideal">

    <DockPanel>

        <!-- ===================== header ===================== -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Skeer.TopBar}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Brand/skeer-mark.png"
                           Width="28" Height="31" Stretch="Uniform" />
                    <Image Source="pack://application:,,,/Brand/skeer-wordmark.png"
                           Height="19" Stretch="Uniform" Margin="9,0,0,0" />
                    <Border Style="{StaticResource Skeer.BrandDivider}" Margin="14,0" />
                    <TextBlock Style="{StaticResource Skeer.ModuleTitle}"
                               Text="autoSTEM" VerticalAlignment="Center" />
                </StackPanel>

                <Border HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Skeer.Chip}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSimulatedEngine}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding LiveChip}" VerticalAlignment="Center"
                               FontFamily="{StaticResource CondensedFont}" FontSize="10.5" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSimulatedEngine}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentDeepBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- ===================== command bar ===================== -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Skeer.Card}" Margin="14,10,14,14" Padding="16,13">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- status -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconAlert}" Style="{StaticResource Skeer.Icon}"
                          Stroke="{StaticResource RedBrush}" Width="15" Height="15" Margin="0,0,9,0"
                          Visibility="{Binding ShowAlertIcon, Converter={StaticResource BoolToVis}}" />
                    <Path Data="{StaticResource IconCheck}" Style="{StaticResource Skeer.Icon}"
                          Stroke="{StaticResource GreenBrush}" Width="15" Height="15" Margin="0,0,9,0"
                          Visibility="{Binding ShowCheckIcon, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="{Binding BatchSummaryText}" VerticalAlignment="Center"
                               FontFamily="{StaticResource CondensedFont}" FontSize="14.5" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource CharcoalBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BatchSummaryLevel}" Value="failed">
                                        <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BatchSummaryLevel}" Value="ready">
                                        <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BatchSummaryLevel}" Value="running">
                                        <Setter Property="Foreground" Value="{StaticResource AccentDeepBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Style="{StaticResource Skeer.Divider}"
                            Visibility="{Binding ShowBlocker, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Style="{StaticResource Skeer.BlockerText}" Text="{Binding BlockerText}"
                               MaxWidth="560"
                               Visibility="{Binding ShowBlocker, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- actions -->
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Stop after current" Margin="0,0,8,0"
                            Command="{Binding StopAfterCurrentCommand}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                    <Button Content="Retry failed" Margin="0,0,8,0"
                            Command="{Binding RetryFailedCommand}"
                            Visibility="{Binding HasFailures, Converter={StaticResource BoolToVis}}" />

                    <Button x:Name="HousekeepingButton" Content="•••" Margin="0,0,12,0"
                            Style="{StaticResource Skeer.IconButton}" ToolTip="More actions"
                            AutomationProperties.Name="More actions"
                            Click="OnHousekeepingClick">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Clear completed" Command="{Binding ClearCompletedCommand}" />
                                <MenuItem Header="Open output folder" Command="{Binding OpenOutputFolderCommand}" />
                                <MenuItem Header="Open log folder" Command="{Binding OpenLogFolderCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button Content="Diagnostics" Style="{StaticResource Skeer.Link}" Margin="0,0,16,0"
                            Click="OnDiagnosticsClick" />

                    <Button Content="Run" Style="{StaticResource Skeer.Button.Run}"
                            Command="{Binding RunCommand}"
                            ToolTip="{Binding BlockerText}" />
                </StackPanel>

                <!-- running detail -->
                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0"
                      Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding CurrentTrack}" MaxWidth="300"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding CurrentStage}" Margin="10,0,14,0"
                               VerticalAlignment="Center" FontSize="11.5"
                               Foreground="{StaticResource MutedInkBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="260" />
                    <ProgressBar Grid.Column="2" Height="6" VerticalAlignment="Center"
                                 IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                                 Minimum="0" Maximum="100" Value="{Binding TrackPercent, Mode=OneWay}" />
                </Grid>
            </Grid>
        </Border>

        <!-- ===================== main area ===================== -->
        <Grid Margin="14,14,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="384" />
            </Grid.ColumnDefinitions>

            <!-- queue -->
            <Border Style="{StaticResource Skeer.Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource Skeer.PanelHead}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Skeer.PanelTitle}" Text="Queue" VerticalAlignment="Center" />

                                <Border Style="{StaticResource Skeer.Chip}" Margin="10,0,0,0" Height="20"
                                        Background="{StaticResource RedSoftBrush}"
                                        Visibility="{Binding HasFailures, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding FailurePillText}" VerticalAlignment="Center"
                                               FontFamily="{StaticResource CondensedFont}" FontSize="10.5"
                                               FontWeight="SemiBold" Foreground="{StaticResource RedBrush}" />
                                </Border>

                                <TextBlock Style="{StaticResource Skeer.Mono}" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Text="{Binding TotalCount, StringFormat={}{0} files}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Add files" Style="{StaticResource Skeer.Button.IconText}"
                                        Tag="{StaticResource IconPlus}" Margin="0,0,6,0"
                                        Command="{Binding AddFilesCommand}" />
                                <Button x:Name="AddFolderButton" Content="Add folder"
                                        Style="{StaticResource Skeer.Button.IconText}"
                                        Tag="{StaticResource IconFolder}"
                                        Click="OnAddFolderClick" ToolTip="Add a folder of audio files">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Add folder…" Command="{Binding AddFolderCommand}" />
                                            <MenuItem Header="Include subfolders" IsCheckable="True"
                                                      IsChecked="{Binding IsRecursiveImport, Mode=TwoWay}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- empty state: the drop target only exists while there is nothing to show -->
                    <Grid DockPanel.Dock="Top" Margin="14,14,14,0" MinHeight="220"
                          Visibility="{Binding ShowDropZone, Converter={StaticResource BoolToVis}}">
                        <Rectangle RadiusX="9" RadiusY="9" Stroke="{StaticResource BorderBrush}"
                                   StrokeThickness="1.2" StrokeDashArray="4 3" Fill="Transparent" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconUpload}" Style="{StaticResource Skeer.Icon}"
                                  Width="26" Height="26" HorizontalAlignment="Center"
                                  Stroke="{StaticResource MutedSoftBrush}" StrokeThickness="1.2" />
                            <TextBlock Text="Drag and drop audio files or folders here"
                                       HorizontalAlignment="Center" Margin="0,12,0,0"
                                       FontSize="13.5" FontWeight="SemiBold" />
                            <TextBlock Text="or use Add files / Add folder above"
                                       Style="{StaticResource Skeer.Hint}" HorizontalAlignment="Center"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- populated: a slim hint so a long batch keeps the room -->
                    <Border DockPanel.Dock="Bottom" Padding="14,8" Background="{StaticResource PaperDeepBrush}"
                            BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,0"
                            Visibility="{Binding ShowDropHint, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconUpload}" Style="{StaticResource Skeer.Icon}"
                                  Width="12" Height="12" Margin="0,0,7,0"
                                  Stroke="{StaticResource MutedSoftBrush}" />
                            <TextBlock Text="{Binding DropHint}" Style="{StaticResource Skeer.Hint}" FontSize="10.5" />
                        </StackPanel>
                    </Border>

                    <DataGrid ItemsSource="{Binding Jobs}" RowDetailsVisibilityMode="Visible"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="File" Width="2*" MinWidth="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Path Grid.Column="0" Data="{StaticResource IconFile}"
                                                  Style="{StaticResource Skeer.Icon}"
                                                  Width="13" Height="13" Margin="0,0,8,0"
                                                  Stroke="{StaticResource MutedSoftBrush}" />
                                            <!-- A Grid, not a StackPanel: the text needs a real width to trim with an ellipsis. -->
                                            <TextBlock Grid.Column="1" Text="{Binding FileName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FilePath}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Status" Width="112">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding StatusLabel}"
                                                        Style="{StaticResource Skeer.StatusBadge}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Details" Width="3*" MinWidth="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding DetailsText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DetailsText}"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="View details" Margin="10,0,0,0"
                                                    Style="{StaticResource Skeer.Link}"
                                                    Command="{Binding DataContext.ToggleRowDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding HasPartial, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="•••" Style="{StaticResource Skeer.IconButton}"
                                                ToolTip="Row details, settings and output"
                                                AutomationProperties.Name="Row details"
                                                Command="{Binding DataContext.ToggleRowDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>

                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Skeer.RowDetails}"
                                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock Style="{StaticResource Skeer.FieldLabel}" Text="Saved settings" />
                                            <TextBlock Style="{StaticResource Skeer.FieldValue}" Text="{Binding SettingsSummary}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,16,0">
                                            <TextBlock Style="{StaticResource Skeer.FieldLabel}" Text="Output" />
                                            <TextBlock Style="{StaticResource Skeer.FieldValue}"
                                                       Text="{Binding OutputSummary}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal"
                                                    VerticalAlignment="Bottom">
                                            <Button Content="Open results" Style="{StaticResource Skeer.Button.Small}"
                                                    Margin="0,0,6,0" Visibility="{Binding CanOpenResults, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.OpenRowResultsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Open partial" Style="{StaticResource Skeer.Button.Small}"
                                                    Margin="0,0,6,0" Visibility="{Binding CanOpenPartial, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.OpenRowPartialCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Remove" Style="{StaticResource Skeer.Button.Small}"
                                                    Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0"
                                                    Visibility="{Binding HasPartial, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Style="{StaticResource Skeer.FieldLabel}" Text="Partial output (verified)" />
                                            <TextBlock Style="{StaticResource Skeer.FieldValue}" Text="{Binding PartialSummary}" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding DetailsHelp}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Skeer.Hint}">
                                                    <Setter Property="Margin" Value="0,10,0,0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DetailsHelp}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- batch settings -->
            <Border Grid.Column="1" Style="{StaticResource Skeer.Card}" Margin="12,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource Skeer.PanelHead}">
                        <TextBlock Style="{StaticResource Skeer.PanelTitle}" Text="Batch settings" />
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,14,16,18">

                            <TextBlock Style="{StaticResource Skeer.FieldLabel}" Text="Output folder" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                                             Height="34" />
                                    <TextBlock Text="Choose a folder" Margin="11,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False"
                                               FontSize="12.5" Foreground="{StaticResource MutedSoftBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OutputFolder}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                    <Button Content="Browse" Height="34" Command="{Binding BrowseOutputFolderCommand}" />
                                    <Button Content="Open" Height="34" Margin="6,0,0,0"
                                            Visibility="{Binding HasOutputFolder, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding OpenOutputFolderCommand}" />
                                </StackPanel>
                            </Grid>

                            <Separator />

                            <TextBlock Style="{StaticResource Skeer.FieldLabel}" Text="Stems" />
                            <Border Style="{StaticResource Skeer.SegmentGroup}">
                                <UniformGrid Rows="1" Columns="3">
                                    <RadioButton Content="All" Style="{StaticResource Skeer.Segment}"
                                                 IsChecked="{Binding IsAllStems}" />
                                    <RadioButton Content="Drums only" Style="{StaticResource Skeer.Segment}"
                                                 IsChecked="{Binding IsDrumsOnly}" />
                                    <RadioButton Content="Custom" Style="{StaticResource Skeer.Segment}"
                                                 IsChecked="{Binding IsCustomStems}" />
                                </UniformGrid>
                            </Border>

                            <TextBlock Text="{Binding StemsSummaryText}" Margin="2,9,0,0"
                                       FontSize="11.5" Foreground="{StaticResource MutedInkBrush}" />

                            <StackPanel Margin="2,4,0,0"
                                        Visibility="{Binding IsCustomStems, Converter={StaticResource BoolToVis}}">
                                <CheckBox Content="Vocals" IsChecked="{Binding StemVocals}" />
                                <CheckBox Content="Drums" IsChecked="{Binding StemDrums}" />
                                <CheckBox Content="Bass" IsChecked="{Binding StemBass}" />
                                <CheckBox Content="Others" IsChecked="{Binding StemOthers}" />
                            </StackPanel>

                            <Separator />

                            <TextBlock Style="{StaticResource Skeer.FieldLabel}" Text="Processing" />
                            <Border Style="{StaticResource Skeer.SegmentGroup}" ToolTip="{Binding StemModeHint}">
                                <UniformGrid Rows="1" Columns="2">
                                    <RadioButton Content="High Speed" Style="{StaticResource Skeer.Segment}"
                                                 IsChecked="{Binding IsHighSpeed}" />
                                    <RadioButton Content="High Quality" Style="{StaticResource Skeer.Segment}"
                                                 IsChecked="{Binding IsHighQuality}" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Style="{StaticResource Skeer.Hint}" Margin="2,9,0,0"
                                       Text="High Speed runs in a single pass. Hover the control for what High Quality changes." />

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
