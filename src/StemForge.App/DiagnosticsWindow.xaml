<Window x:Class="StemForge.App.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnostics"
        Height="620" Width="660"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource IvoryBrush}"
        Foreground="{StaticResource CharcoalBrush}">

    <DockPanel Margin="14">

        <Border DockPanel.Dock="Top" Style="{StaticResource Skeer.TopBar}" Margin="-14,-14,-14,0" Padding="14,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Brand/skeer-mark.png" Width="22" Height="25" Stretch="Uniform" />
                    <TextBlock Style="{StaticResource Skeer.ModuleTitle}" Text="Diagnostics"
                               FontSize="17" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding LiveChip}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontFamily="{StaticResource CondensedFont}" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedInkBrush}" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Style="{StaticResource Skeer.Button.Primary}" MinWidth="96"
                        Click="OnCloseClick" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
            <StackPanel>

                <!-- Ableton Live -->
                <Border Style="{StaticResource Skeer.Card}" Padding="14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Skeer.SectionLabel}" Text="Ableton Live" />
                        <TextBlock Style="{StaticResource Skeer.FieldValue}" Text="{Binding LiveStatus}" />
                        <TextBlock Style="{StaticResource Skeer.FieldLabel}" Text="Executable" Margin="0,10,0,3" />
                        <TextBlock Style="{StaticResource Skeer.FieldValue}" FontFamily="{StaticResource MonoFont}"
                                   FontSize="10.5" Text="{Binding LiveExePath}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Locate" Margin="0,0,6,0" Command="{Binding LocateLiveCommand}" />
                            <Button Content="Browse" Command="{Binding BrowseLiveCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- run log -->
                <Border Style="{StaticResource Skeer.Card}" Padding="14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Skeer.SectionLabel}" Text="Run log" />
                        <TextBlock Style="{StaticResource Skeer.FieldValue}" FontFamily="{StaticResource MonoFont}"
                                   FontSize="10.5" Text="{Binding LogFilePath}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- working areas -->
                <Border Style="{StaticResource Skeer.Card}" Padding="14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Skeer.SectionLabel}" Text="Working folders" />
                        <TextBlock Style="{StaticResource Skeer.FieldLabel}" Text="Per-job working projects" />
                        <TextBlock Style="{StaticResource Skeer.FieldValue}" FontFamily="{StaticResource MonoFont}"
                                   FontSize="10.5" Text="{Binding WorkingFolderPath}" />
                        <TextBlock Style="{StaticResource Skeer.FieldLabel}" Text="Application data" Margin="0,10,0,3" />
                        <TextBlock Style="{StaticResource Skeer.FieldValue}" FontFamily="{StaticResource MonoFont}"
                                   FontSize="10.5" Text="{Binding AppDataFolder}" />
                        <TextBlock Style="{StaticResource Skeer.FieldLabel}" Text="Supported input types" Margin="0,10,0,3" />
                        <TextBlock Style="{StaticResource Skeer.FieldValue}" Text="{Binding SupportedFormats}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Open output folder" Margin="0,0,6,0"
                                    Command="{Binding OpenOutputFolderCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- advanced -->
                <Border Style="{StaticResource Skeer.Card}" Padding="14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Skeer.SectionLabel}" Text="Options" />
                        <CheckBox Content="Keep Windows awake during a run" IsChecked="{Binding IsKeepAwake}" />
                        <CheckBox Content="Use simulated engine (no Ableton Live)" Margin="0,8,0,0"
                                  IsChecked="{Binding IsSimulatedEngine}" />
                        <TextBlock Style="{StaticResource Skeer.Hint}" Margin="0,7,0,0"
                                   Text="The simulated engine writes placeholder stems and never reports them as Ableton output. It exists to exercise the queue, resume and verification logic." />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
