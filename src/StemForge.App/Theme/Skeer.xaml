<!--
    SKEER appearance system — StemForge

    Warm ivory paper, pale stone, charcoal ink, one orange signal.

    Token names and values come from the SKEER DJ LIBRARY appearance system so the two
    apps read as one family: same palette, same IBM Plex / Barlow Condensed stack, same
    uppercase tracked micro-labels, same 8/6/4 px radii and 1 px stone borders.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:theme="clr-namespace:StemForge.App.Theme">

    <!-- ====================== colour tokens ====================== -->
    <Color x:Key="IvoryColor">#F5F2EB</Color>
    <Color x:Key="PaperColor">#FCFAF6</Color>
    <Color x:Key="PaperDeepColor">#F8F5EE</Color>
    <Color x:Key="StoneColor">#E7E2D8</Color>
    <Color x:Key="StoneSoftColor">#EFEBE3</Color>
    <Color x:Key="StoneDeepColor">#DCD6CA</Color>
    <Color x:Key="BorderColor">#CFC8BC</Color>
    <Color x:Key="BorderSoftColor">#DED8CC</Color>
    <Color x:Key="CharcoalColor">#292821</Color>
    <Color x:Key="InkColor">#211F1A</Color>
    <Color x:Key="MutedInkColor">#716C63</Color>
    <Color x:Key="MutedSoftColor">#938D83</Color>
    <Color x:Key="AccentColor">#FF6500</Color>
    <Color x:Key="AccentDeepColor">#E05600</Color>
    <Color x:Key="AccentSoftColor">#FFE6D5</Color>
    <Color x:Key="GreenColor">#1F8A4C</Color>
    <Color x:Key="GreenSoftColor">#DFF2E6</Color>
    <Color x:Key="RedColor">#C63A2F</Color>
    <Color x:Key="RedSoftColor">#FBE3E1</Color>
    <Color x:Key="AmberColor">#B5791F</Color>
    <Color x:Key="AmberSoftColor">#F7ECD7</Color>
    <Color x:Key="SlateColor">#3F6F9E</Color>
    <Color x:Key="SlateSoftColor">#E3EBF3</Color>

    <SolidColorBrush x:Key="IvoryBrush" Color="{StaticResource IvoryColor}" />
    <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource PaperColor}" />
    <SolidColorBrush x:Key="PaperDeepBrush" Color="{StaticResource PaperDeepColor}" />
    <SolidColorBrush x:Key="StoneBrush" Color="{StaticResource StoneColor}" />
    <SolidColorBrush x:Key="StoneSoftBrush" Color="{StaticResource StoneSoftColor}" />
    <SolidColorBrush x:Key="StoneDeepBrush" Color="{StaticResource StoneDeepColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderSoftBrush" Color="{StaticResource BorderSoftColor}" />
    <SolidColorBrush x:Key="CharcoalBrush" Color="{StaticResource CharcoalColor}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="MutedInkBrush" Color="{StaticResource MutedInkColor}" />
    <SolidColorBrush x:Key="MutedSoftBrush" Color="{StaticResource MutedSoftColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource AccentDeepColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenColor}" />
    <SolidColorBrush x:Key="GreenSoftBrush" Color="{StaticResource GreenSoftColor}" />
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource RedColor}" />
    <SolidColorBrush x:Key="RedSoftBrush" Color="{StaticResource RedSoftColor}" />
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="AmberSoftBrush" Color="{StaticResource AmberSoftColor}" />
    <SolidColorBrush x:Key="SlateBrush" Color="{StaticResource SlateColor}" />
    <SolidColorBrush x:Key="SlateSoftBrush" Color="{StaticResource SlateSoftColor}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="AccentGripBrush" Color="{StaticResource AccentColor}" Opacity="0.22" />

    <!-- ====================== type tokens ====================== -->
    <FontFamily x:Key="SansFont">IBM Plex Sans, Segoe UI</FontFamily>
    <FontFamily x:Key="CondensedFont">Barlow Condensed, IBM Plex Sans Condensed, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">IBM Plex Mono, Consolas</FontFamily>

    <!-- ====================== elevation (frozen: shared across elements) ====================== -->
    <DropShadowEffect x:Key="PopShadow" po:Freeze="True"
                      BlurRadius="28" ShadowDepth="4" Direction="270"
                      Color="{StaticResource CharcoalColor}" Opacity="0.16" />

    <DropShadowEffect x:Key="FocusGlow" po:Freeze="True"
                      BlurRadius="6" ShadowDepth="0"
                      Color="{StaticResource AccentColor}" Opacity="0.35" />

    <!-- ====================== text ====================== -->
    <Style x:Key="Skeer.Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource CharcoalBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style TargetType="TextBlock" BasedOn="{StaticResource Skeer.Text}" />

    <!-- Small uppercase condensed label: `.label` / `.section-label` -->
    <Style x:Key="Skeer.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CondensedFont}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
        <Setter Property="theme:Typography.Tracking" Value="0.09" />
    </Style>

    <Style x:Key="Skeer.SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Skeer.Label}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource MutedSoftBrush}" />
        <Setter Property="theme:Typography.Tracking" Value="0.1" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="Skeer.PanelTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CondensedFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource CharcoalBrush}" />
    </Style>

    <Style x:Key="Skeer.ModuleTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CondensedFont}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource CharcoalBrush}" />
    </Style>

    <Style x:Key="Skeer.Muted" TargetType="TextBlock" BasedOn="{StaticResource Skeer.Text}">
        <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
    </Style>

    <Style x:Key="Skeer.Hint" TargetType="TextBlock" BasedOn="{StaticResource Skeer.Text}">
        <Setter Property="Foreground" Value="{StaticResource MutedSoftBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Numeric readouts use tabular mono so columns stay aligned. -->
    <Style x:Key="Skeer.Mono" TargetType="TextBlock" BasedOn="{StaticResource Skeer.Text}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
    </Style>

    <Style x:Key="Skeer.StatusText" TargetType="TextBlock" BasedOn="{StaticResource Skeer.Text}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
    </Style>

    <Style x:Key="Skeer.StatusText.Strong" TargetType="TextBlock" BasedOn="{StaticResource Skeer.StatusText}">
        <Setter Property="Foreground" Value="{StaticResource CharcoalBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ====================== surfaces ====================== -->
    <Style x:Key="Skeer.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PaperBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Skeer.PanelHead" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PaperBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="MinHeight" Value="46" />
    </Style>

    <Style x:Key="Skeer.TopBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PaperBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Height" Value="58" />
    </Style>

    <Style x:Key="Skeer.StatusBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PaperBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinHeight" Value="30" />
    </Style>

    <Style x:Key="Skeer.BrandDivider" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Background" Value="{StaticResource BorderBrush}" />
    </Style>

    <!-- ====================== chips and dots ====================== -->
    <Style x:Key="Skeer.Chip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource StoneSoftBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="Height" Value="21" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Skeer.ChipText" TargetType="TextBlock" BasedOn="{StaticResource Skeer.Text}">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Skeer.StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="Fill" Value="{StaticResource GreenBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ====================== buttons ====================== -->
    <DataTemplate x:Key="Skeer.ButtonText">
        <TextBlock Text="{Binding}"
                   FontFamily="{StaticResource CondensedFont}"
                   FontSize="12.5"
                   FontWeight="SemiBold"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                   theme:Typography.Tracking="0.06"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
    </DataTemplate>

    <ControlTemplate x:Key="Skeer.ButtonChrome" TargetType="ButtonBase">
        <Border x:Name="Chrome"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="6"
                SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource StoneSoftBrush}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource MutedSoftBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource StoneBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="Skeer.ButtonChrome.Primary" TargetType="ButtonBase">
        <Border x:Name="Chrome"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="6"
                SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentDeepBrush}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentDeepBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentDeepBrush}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentDeepBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource StoneSoftBrush}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
                <Setter Property="Foreground" Value="{StaticResource MutedSoftBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PaperBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource CharcoalBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="68" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template" Value="{StaticResource Skeer.ButtonChrome}" />
        <Setter Property="ContentTemplate" Value="{StaticResource Skeer.ButtonText}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="Skeer.Button.Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
        <Setter Property="Template" Value="{StaticResource Skeer.ButtonChrome.Primary}" />
    </Style>

    <Style x:Key="Skeer.Button.Small" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="MinWidth" Value="0" />
    </Style>

    <!-- ====================== inputs ====================== -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource PaperDeepBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
        <Setter Property="Foreground" Value="{StaticResource CharcoalBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentGripBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PaperBrush}" />
                            <Setter TargetName="Chrome" Property="Effect" Value="{StaticResource FocusGlow}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================== toggles ====================== -->
    <Style x:Key="Skeer.ToggleBase" TargetType="Control">
        <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource CharcoalBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource Skeer.ToggleBase}">
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                Background="{StaticResource PaperBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="Check" Margin="3" Stretch="Uniform"
                                  Stroke="{StaticResource WhiteBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M 0,4 L 3.2,7.2 L 9,0"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource MutedSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton" BasedOn="{StaticResource Skeer.ToggleBase}">
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Ring" Width="16" Height="16" CornerRadius="8"
                                Background="{StaticResource PaperBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Ellipse x:Name="Dot" Width="7" Height="7"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Fill="{StaticResource WhiteBrush}" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource MutedSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================== progress ====================== -->
    <!--
        Progress is only determinate when the engine reports a reliable percentage. The
        indeterminate state is an explicit pulsing bar rather than the default sliding
        animation, which a custom template cannot express without measuring the track.
    -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="10" />
        <Setter Property="Background" Value="{StaticResource StoneSoftBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="5"
                            ClipToBounds="True" SnapsToDevicePixels="True">
                        <Grid>
                            <Rectangle x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="5" />
                            <Border x:Name="Busy" Background="{TemplateBinding Foreground}"
                                    CornerRadius="5" Opacity="0.25" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Busy" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="PulseStoryboard">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="Busy"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0.20" To="0.85" Duration="0:0:0.9" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="PulseStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================== separators ====================== -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource BorderSoftBrush}" />
        <Setter Property="Margin" Value="0,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}" Height="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================== scrollbars ====================== -->
    <Style x:Key="Skeer.ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Chrome" Background="{StaticResource StoneDeepBrush}"
                            CornerRadius="5" Margin="2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Skeer.ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="10" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
    </Style>

    <!-- ====================== tooltips ====================== -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource CharcoalBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MaxWidth" Value="380" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource PaperBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="11,8"
                            Effect="{StaticResource PopShadow}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================== data grid ====================== -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource PaperBrush}" />
        <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource CondensedFont}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="8,8" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Foreground" Value="{StaticResource CharcoalBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource PaperBrush}" />
        <!-- MinHeight, not Height: the row has to be able to grow for its details panel. -->
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Border x:Name="RowChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BorderSoftBrush}"
                            BorderThickness="0,0,0,1"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border x:Name="AccentBar" Grid.RowSpan="2" Width="2" HorizontalAlignment="Left"
                                    Background="{StaticResource AccentBrush}" Visibility="Collapsed" />
                            <DataGridCellsPresenter Grid.Row="0" VerticalAlignment="Center" />
                            <DataGridDetailsPresenter Grid.Row="1" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowChrome" Property="Background" Value="{StaticResource PaperDeepBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RowChrome" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource PaperBrush}" />
        <Setter Property="RowBackground" Value="{StaticResource PaperBrush}" />
        <Setter Property="Foreground" Value="{StaticResource CharcoalBrush}" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- ====================== icons ====================== -->
    <Geometry x:Key="IconPlus">M8 3.5 V12.5 M3.5 8 H12.5</Geometry>
    <Geometry x:Key="IconFolder">M2.5 4.6 A1.1 1.1 0 0 1 3.6 3.5 H6.1 L7.6 5.3 H12.4 A1.1 1.1 0 0 1 13.5 6.4 V11.4 A1.1 1.1 0 0 1 12.4 12.5 H3.6 A1.1 1.1 0 0 1 2.5 11.4 Z</Geometry>
    <Geometry x:Key="IconFile">M5.2 2.5 H9.6 L12.8 5.7 V13.5 H5.2 Z M9.6 2.5 V5.7 H12.8</Geometry>
    <Geometry x:Key="IconUpload">M8 11.6 V3.4 M4.4 7 L8 3.4 L11.6 7 M2.6 13.6 H13.4</Geometry>
    <Geometry x:Key="IconPlay">M4.4 2.9 L13 8 L4.4 13.1 Z</Geometry>
    <Geometry x:Key="IconAlert">M8 2.4 L15 14 H1 Z M8 6.6 V9.8 M8 11.6 V11.9</Geometry>
    <Geometry x:Key="IconCheck">M2.8 8.4 L6.4 12 L13.2 3.8</Geometry>

    <Style x:Key="Skeer.Icon" TargetType="Path">
        <Setter Property="Stroke" Value="{StaticResource MutedInkBrush}" />
        <Setter Property="StrokeThickness" Value="1.4" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Fill" Value="{StaticResource TransparentBrush}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Skeer.Icon.Filled" TargetType="Path" BasedOn="{StaticResource Skeer.Icon}">
        <Setter Property="Stroke" Value="{StaticResource TransparentBrush}" />
        <Setter Property="Fill" Value="{StaticResource MutedInkBrush}" />
    </Style>

    <!-- ====================== status badges ====================== -->
    <!-- Red carries failure; orange is reserved for the primary action and active selections. -->
    <Style x:Key="Skeer.StatusBadge" TargetType="ContentControl">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border x:Name="Chip" CornerRadius="4" Height="20" Padding="7,0"
                            Background="{StaticResource StoneSoftBrush}" SnapsToDevicePixels="True">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource CondensedFont}" FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedInkBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding StatusLevel}" Value="processing">
                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource SlateSoftBrush}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource SlateBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusLevel}" Value="completed">
                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource GreenSoftBrush}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource GreenBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusLevel}" Value="failed">
                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource RedSoftBrush}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource RedBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusLevel}" Value="skipped">
                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource StoneSoftBrush}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource MutedSoftBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================== icons inside buttons ====================== -->
    <DataTemplate x:Key="Skeer.ButtonIconText">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Path Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                  Style="{StaticResource Skeer.Icon}" Width="13" Height="13" Margin="0,0,7,0" />
            <TextBlock Text="{Binding}"
                       FontFamily="{StaticResource CondensedFont}" FontSize="12.5" FontWeight="SemiBold"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                       theme:Typography.Tracking="0.04"
                       VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <Style x:Key="Skeer.Button.IconText" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="ContentTemplate" Value="{StaticResource Skeer.ButtonIconText}" />
    </Style>

    <DataTemplate x:Key="Skeer.ButtonIconText.Filled">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Path Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                  Style="{StaticResource Skeer.Icon.Filled}"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                  Width="12" Height="12" Margin="0,0,8,0" />
            <TextBlock Text="{Binding}"
                       FontFamily="{StaticResource CondensedFont}" FontSize="12.5" FontWeight="SemiBold"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                       theme:Typography.Tracking="0.04"
                       VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <Style x:Key="Skeer.Button.Run" TargetType="Button" BasedOn="{StaticResource Skeer.Button.Primary}">
        <Setter Property="Tag" Value="{StaticResource IconPlay}" />
        <Setter Property="ContentTemplate" Value="{StaticResource Skeer.ButtonIconText.Filled}" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="MinWidth" Value="96" />
    </Style>

    <!-- Borderless icon button, used for the row overflow menu. -->
    <Style x:Key="Skeer.IconButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource StoneSoftBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource CharcoalBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================== menus ====================== -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource PaperBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource CharcoalBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="4"
                            Effect="{StaticResource PopShadow}">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource CharcoalBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource StoneSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ====================== segmented control ====================== -->
    <Style x:Key="Skeer.Segment" TargetType="RadioButton" BasedOn="{StaticResource Skeer.ToggleBase}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{StaticResource CharcoalBrush}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               FontFamily="{StaticResource CondensedFont}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                               theme:Typography.Tracking="0.04"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Seg" Background="Transparent" CornerRadius="5" Padding="10,0"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Seg" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Seg" Property="Background" Value="{StaticResource StoneSoftBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Seg" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Skeer.SegmentGroup" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PaperBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ====================== text link ====================== -->
    <Style x:Key="Skeer.Link" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AccentDeepBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="11.5"
                               TextDecorations="Underline"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="0">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================== command bar ====================== -->
    <Style x:Key="Skeer.SummaryText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CondensedFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource CharcoalBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Skeer.BlockerText" TargetType="TextBlock" BasedOn="{StaticResource Skeer.Text}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Skeer.Divider" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Background" Value="{StaticResource BorderBrush}" />
        <Setter Property="Margin" Value="12,0" />
    </Style>

    <!-- ====================== row details ====================== -->
    <Style x:Key="Skeer.RowDetails" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PaperDeepBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="14,10" />
    </Style>

    <Style x:Key="Skeer.FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Skeer.Label}">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Margin" Value="0,0,0,3" />
    </Style>

    <Style x:Key="Skeer.FieldValue" TargetType="TextBlock" BasedOn="{StaticResource Skeer.Text}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
